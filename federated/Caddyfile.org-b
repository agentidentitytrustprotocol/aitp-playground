# TLS terminator for org-B. Real https on the org-B domain, backed by the
# local test CA (federated/certs). Agent-facing paths go to the hosted agent's
# pinned port (9100); anything else falls through to the playground control API
# (8000) — unused cross-domain but harmless.
{
	auto_https off
}

https://org-b.aitp.test {
	tls /certs/org-b.aitp.test.crt /certs/org-b.aitp.test.key
	@agent path /.well-known/* /aitp/* /capabilities/*
	reverse_proxy @agent pg-b:9100
	reverse_proxy pg-b:8000
}
