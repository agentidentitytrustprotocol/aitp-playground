# Local configuration template. Copy to .env (gitignored) and edit.
# Team members: the source of truth is Doppler project aitp-playground,
# config dev (`doppler setup -p aitp-playground -c dev`, then
# `doppler run -- <command>`) for native runs. docker compose still
# reads this file as .env.
# The hosted deployment reads Doppler config prd: see docs/deployment.md.
PORT=8000
HOST=0.0.0.0
SCENARIOS_DIR=./scenarios
REGISTRY_CACHE_TTL_MS=0
AGENT_BASE_PORT=8100
AGENT_PYTHON=python3
PLAYGROUND_BASE_URL=http://localhost:8000
CP_BASE_URL=
CP_API_KEY=
CP_TIMEOUT_MS=5000
# Axis B: what to do about the ABSENCE of a fresh verified snapshot. Never
# governs authenticity — a forged snapshot is discarded either way, in every
# mode. fail_closed (default) refuses capability calls while degraded;
# soft_fail serves on the last verified deny-set.
REVOCATION_FAIL_MODE=fail_closed
REVOCATION_MAX_STALENESS_SECS=300
REVOCATION_POLL_SECS=60
# Public origin this service advertises for agents it hosts via
# POST /hosted-agents (federated/cross-domain demos). Leave PUBLIC_HOST empty
# for "no public origin".
PUBLIC_HOST=
PUBLIC_SCHEME=https
# Local/test only: scenario agents serve plain http://localhost instead of TLS
# on loopback, and SDK calls pass insecure_localhost_dangerous. Non-loopback
# http:// is refused either way. The service will not start with this on Railway.
INSECURE_LOCALHOST_DANGEROUS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which LLM provider the agents should call: openai (default) or anthropic.
LLM_PROVIDER=openai
# Optional model overrides (sensible defaults baked in).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
# Bearer key(s) for every non-static route; comma-separated to overlap a
# rotation. Empty fails closed (503). Generate: openssl rand -hex 32
PLAYGROUND_API_KEY=
# Spend guards (in-process; valid for a single replica only — SECURITY.md).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
MAX_RUNS_PER_HOUR=30
RUN_RATE_LIMIT_PER_IP=5
RUN_RATE_LIMIT_WINDOW_SECONDS=600
MAX_CONCURRENT_RUNS=3
RUN_DEADLINE_SECONDS=900
# LLM-call quotas (per trusted client IP and global, per UTC day / month).
LLM_QUOTA_PER_IP_PER_DAY=30
LLM_QUOTA_PER_IP_PER_MONTH=300
LLM_QUOTA_GLOBAL_PER_DAY=1000
LLM_QUOTA_GLOBAL_PER_MONTH=10000
# auto | postgres | memory | unavailable. auto: postgres if DATABASE_URL is
# set, else memory locally and unavailable (refuse real calls) on Railway.
LLM_QUOTA_STORE=auto
# DATABASE_URL=postgresql://user:password@host:5432/db
RUN_TOKEN_BUDGET=40000
LLM_MAX_TOKENS_PER_CALL=1024
LOG_LEVEL=INFO
# Optional: persist run history (records + events) to this SQLite file
# so they survive a service restart. Leave empty for in-memory only.
RUN_HISTORY_DB=
