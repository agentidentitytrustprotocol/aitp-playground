PORT=8000
HOST=0.0.0.0
SCENARIOS_DIR=./scenarios
REGISTRY_CACHE_TTL_MS=0
AGENT_BASE_PORT=8100
AGENT_PYTHON=python3
PLAYGROUND_BASE_URL=http://localhost:8000
CP_BASE_URL=
CP_API_KEY=
CP_TIMEOUT_MS=5000
# The control plane's pinned AID. With CP_BASE_URL set and this left empty,
# every revocation snapshot is discarded (logged loudly at start-up) and the
# agent runs UNCHECKED, not un-configured — set this to actually verify
# revocation. In the docker-compose stack the CP's identity is deterministic
# (CP_AID_SEED_HEX); in a real deployment it comes from the CP's own
# published manifest, pinned once.
CP_AID=
# Axis B: what to do about the ABSENCE of a fresh verified snapshot. Never
# governs authenticity — a forged snapshot is discarded either way, in every
# mode. fail_closed (default) refuses capability calls while degraded;
# soft_fail serves on the last verified deny-set.
REVOCATION_FAIL_MODE=fail_closed
REVOCATION_MAX_STALENESS_SECS=300
REVOCATION_POLL_SECS=60
# Public origin this service advertises for agents it hosts via
# POST /hosted-agents (federated/cross-domain demos). Leave PUBLIC_HOST empty
# for "no public origin" — hosted agents behave exactly as before.
PUBLIC_HOST=
PUBLIC_SCHEME=http
# Comma-separated host (or .suffix) allowlist for which did:web hosts may be
# resolved over plain http instead of https. Test-only escape hatch for the
# Level 1 federated stack; production leaves this empty. NOT read via this
# .env file by default — trust/resolver.py reads it directly from
# os.environ, which pydantic-settings' .env loader does not populate. Export
# it in the actual process environment if you need it locally.
AITP_DIDWEB_INSECURE_HOSTS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which LLM provider the agents should call: openai (default) or anthropic.
LLM_PROVIDER=openai
# Optional model overrides (sensible defaults baked in).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
LOG_LEVEL=INFO
# Optional: persist run history (records + events) to this SQLite file
# so they survive a service restart. Leave empty for in-memory only.
RUN_HISTORY_DB=
